{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": true,
    "declarationDir": "dist/types",
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": false,
    "types": ["node", "react", "react-dom"]
  },
  // Built from the entry points, so only what an export reaches is emitted:
  // the unexported prototypes stay out. The Vite types declare the
  // stylesheets the parts import; the invoker types, the dialogs' commands.
  "include": [],
  "files": [
    "src/vite-env.d.ts",
    "src/react-invoker-commands.d.ts",
    "src/index.ts",
    "src/lib/virtualization/index.ts"
  ]
}
