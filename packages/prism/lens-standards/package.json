{
  "name": "@canonical/prism-lens-standards",
  "description": "The Standards lens of a Prism documentation site: a grouped index of the graph's code standards and a reading page for each, rendering its prose with a chip for every entity it mentions",
  "version": "0.44.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/testing"
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma-web"
  },
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma-web/issues"
  },
  "homepage": "https://github.com/canonical/pragma-web#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "schema": "bun scripts/writeSchema.ts",
    "build": "bun run relay",
    "build:all": "bun run relay",
    "relay": "bun run schema && mkdir -p src/__generated__ && relay-compiler --project lens-standards",
    "check": "bun run check:tier2 && bun run check:biome && bun run check:ts",
    "check:tier2": "bun run schema && relay-compiler --project lens-standards --validate",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/src/__generated__",
          "{projectRoot}/.relay"
        ]
      },
      "build:all": {
        "outputs": [
          "{projectRoot}/src/__generated__",
          "{projectRoot}/.relay"
        ]
      }
    }
  },
  "dependencies": {
    "@canonical/i18n-core": "^0.44.1",
    "@canonical/prism-core": "^0.44.1",
    "@canonical/prism-projections": "^0.44.1",
    "@canonical/react-head": "^0.44.1",
    "@canonical/react-markdown": "^0.44.1",
    "@canonical/router-core": "^0.44.1",
    "@canonical/router-react": "^0.44.1",
    "react": "^19.2.4",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@canonical/biome-config": "0.43.0",
    "@canonical/prism-contract": "^0.44.1",
    "@canonical/typescript-config-react": "^0.44.1",
    "@canonical/vitest-config-react": "^0.44.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "graphql": "^16.11.0",
    "jsdom": "^28.1.0",
    "react-dom": "^19.2.4",
    "relay-compiler": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.0"
  }
}
