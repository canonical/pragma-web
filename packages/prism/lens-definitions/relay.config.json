{
  "root": "..",
  "sources": {
    "lens-definitions/src": "lens-definitions",
    "projections/src": "prism-projections"
  },
  "excludes": ["**/node_modules/**", "**/__generated__/**"],
  "projects": {
    "prism-projections": {
      "schema": "contract/schema/contract.graphql",
      "language": "typescript",
      "eagerEsModules": true,
      "output": "lens-definitions/.relay/prism-projections",
      "schemaConfig": {
        "nodeInterfaceIdField": "uri",
        "nodeInterfaceIdVariableName": "id"
      }
    },
    "lens-definitions": {
      "base": "prism-projections",
      "schema": "contract/schema/contract.graphql",
      "language": "typescript",
      "eagerEsModules": true,
      "output": "lens-definitions/src/__generated__",
      "schemaConfig": {
        "nodeInterfaceIdField": "uri",
        "nodeInterfaceIdVariableName": "id"
      }
    }
  }
}
