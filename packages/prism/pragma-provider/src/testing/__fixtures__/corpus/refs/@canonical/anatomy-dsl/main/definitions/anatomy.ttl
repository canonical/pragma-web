# THE COLLISION, and the annotation that resolves it, reproduced.
#
# `anatomy:uri` is an ordinary owl:DatatypeProperty that maps to the GraphQL
# field name `uri` — which the converged base reserves as the injected primary
# key on every Node implementer. Left alone it is an M005 error and the boot
# dies. The real anatomy DSL (`@canonical/anatomy-dsl` 0.43.0 and later)
# resolves this in the ontology itself with `graphql:name "anatomyUri"`, and
# this stand-in carries the same annotation so the corpus compiles the way the
# published package does. `createPragmaProvider.test.ts` measures both halves:
# that the annotation is honoured, and that stripping it is fatal.

@prefix anatomy: <http://anatomy-dsl.example.org/ontology#> .
@prefix graphql: <https://pragma.canonical.com/graphql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

anatomy:NamedNode a owl:Class ;
    rdfs:comment "Design system entity instantiable by consumers." .

anatomy:uri a owl:DatatypeProperty ;
    graphql:name "anatomyUri" ;
    rdfs:domain anatomy:NamedNode ;
    rdfs:range xsd:string ;
    rdfs:comment "Unique identifier for a named node within the design system." .
