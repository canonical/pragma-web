{
  "name": "@canonical/prism-lens-entity",
  "description": "The class-bound docs view of a Prism documentation site: an index of a bound class's instances, as rows or cards, and a page per instance with its summary, its fields and its relations",
  "version": "0.44.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "!src/testing"
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma-web"
  },
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma-web/issues"
  },
  "homepage": "https://github.com/canonical/pragma-web#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run relay",
    "build:all": "bun run relay && bun run build:storybook",
    "build:storybook": "bun run relay && storybook build",
    "relay": "mkdir -p src/__generated__ && relay-compiler --project lens-entity",
    "check": "bun run check:tier1 && bun run check:biome && bun run check:ts",
    "check:tier1": "relay-compiler --project lens-entity --validate",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "bun run relay && storybook dev -p 6014 --no-open --host 0.0.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/src/__generated__"
        ]
      },
      "build:all": {
        "outputs": [
          "{projectRoot}/src/__generated__"
        ]
      }
    }
  },
  "dependencies": {
    "@canonical/i18n-core": "^0.44.1",
    "@canonical/prism-core": "^0.44.1",
    "@canonical/prism-projections": "^0.44.1",
    "@canonical/react-ds-global": "^0.44.1",
    "@canonical/react-head": "^0.44.1",
    "@canonical/router-core": "^0.44.1",
    "@canonical/router-react": "^0.44.1",
    "react": "^19.2.4",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@canonical/biome-config": "0.43.0",
    "@canonical/prism-contract": "^0.44.1",
    "@canonical/storybook-addon-relay": "^0.44.1",
    "@canonical/storybook-config": "^0.44.1",
    "@canonical/styles": "^0.44.1",
    "@canonical/typescript-config-react": "^0.44.1",
    "@canonical/vitest-config-react": "^0.44.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@types/relay-test-utils": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^28.1.0",
    "react-dom": "^19.2.4",
    "relay-compiler": "^21.0.1",
    "relay-test-utils": "^21.0.1",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.0"
  }
}
