{
  "name": "@canonical/prism-core",
  "description": "The provider-neutral core of a Prism documentation site: lens chrome components, route facets, the static router, Relay plumbing, homes and entity bindings",
  "version": "0.44.1",
  "type": "module",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./testing": {
      "types": "./testing/index.ts",
      "import": "./testing/index.ts"
    },
    "./testing/browser": {
      "types": "./testing/browser/index.ts",
      "import": "./testing/browser/index.ts"
    }
  },
  "files": [
    "dist",
    "testing"
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/pragma-web"
  },
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma-web/issues"
  },
  "homepage": "https://github.com/canonical/pragma-web#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:package",
    "build:all": "bun run build:package && bun run build:storybook",
    "build:package": "bun run build:package:tsc && bun run build:package:copycss",
    "build:package:tsc": "tsc -p tsconfig.build.json",
    "build:package:copycss": "copyfiles -u 1 'src/lib/{,**/}*.css' dist/esm",
    "build:storybook": "storybook build",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:webarchitect": "webarchitect library",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "storybook": "storybook dev -p 6011 --no-open --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@canonical/i18n-core": "^0.44.1",
    "@canonical/react-ds-app": "^0.44.1",
    "@canonical/react-ds-global": "^0.44.1",
    "@canonical/react-hooks": "^0.44.1",
    "@canonical/router-core": "^0.44.1",
    "@canonical/router-react": "^0.44.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "graphql": "^16.11.0",
    "react": "^19.2.4",
    "relay-runtime": "^21.0.1",
    "relay-runtime-network": "^0.1.0"
  },
  "peerDependencies": {
    "@canonical/anatomy-dsl": "0.43.0",
    "@canonical/summon-core": "0.43.0",
    "playwright": "^1.61.1",
    "vitest": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "peerDependenciesMeta": {
    "@canonical/anatomy-dsl": {
      "optional": true
    },
    "@canonical/summon-core": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@canonical/anatomy-dsl": "0.43.0",
    "@canonical/biome-config": "0.43.0",
    "@canonical/storybook-config": "^0.44.1",
    "@canonical/styles": "^0.44.1",
    "@canonical/summon-core": "0.43.0",
    "@canonical/typescript-config-react": "^0.44.1",
    "@canonical/vitest-config-react": "^0.44.1",
    "@canonical/webarchitect": "0.43.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "copyfiles": "^2.4.1",
    "jsdom": "^28.1.0",
    "playwright": "^1.61.1",
    "react-dom": "^19.2.4",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.0",
    "yaml": "^2.8.1"
  }
}
