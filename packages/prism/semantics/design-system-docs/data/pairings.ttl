@prefix surface: <sem://surface#> .
@prefix dsd: <sem://design-system-docs#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The pairings of the site's jobs with the surfaces that serve them, named
# <job>.<surface> without a kind word: the journeys graph cuts a hop's label
# at 20 characters and already names the hop's kind, so the surface that
# tells two pairings of one job apart stays inside the cut. Each carries its
# role and, for a curated surface, what the arrival keeps; a pairing with
# the GraphQL port carries no arrival, because an agent has nothing to
# reorient. Every surface of the site is paired at least once.

# ---- job.l1

dsd:l1.home a surface:Pairing ;
  rdfs:label "job.l1 to view.home" ;
  rdfs:comment "A first visit lands on the lobby, which names every lens." ;
  surface:forJob dsd:job.l1 ;
  surface:pairsSurface dsd:view.home ;
  surface:pairingRole surface:primary ;
  surface:arrival surface:cold_entry .

dsd:l1.guides a surface:Pairing ;
  rdfs:label "job.l1 to view.guides" ;
  rdfs:comment "The guides walk a newcomer through the system from the start." ;
  surface:forJob dsd:job.l1 ;
  surface:pairsSurface dsd:view.guides ;
  surface:pairingRole surface:secondary ;
  surface:arrival surface:cold_entry .

# ---- job.l2

dsd:l2.standards a surface:Pairing ;
  rdfs:label "job.l2 to view.standards" ;
  rdfs:comment "The standards index shows every rule the code is held to." ;
  surface:forJob dsd:job.l2 ;
  surface:pairsSurface dsd:view.standards ;
  surface:pairingRole surface:primary ;
  surface:arrival surface:cold_entry .

dsd:l2.guides a surface:Pairing ;
  rdfs:label "job.l2 to view.guides" ;
  rdfs:comment "A guide explains how the standards are applied in review." ;
  surface:forJob dsd:job.l2 ;
  surface:pairsSurface dsd:view.guides ;
  surface:pairingRole surface:secondary ;
  surface:arrival surface:cold_entry .

# ---- job.l3

dsd:l3.components a surface:Pairing ;
  rdfs:label "job.l3 to view.components" ;
  rdfs:comment "The catalogue shows the whole set of UI blocks at a glance." ;
  surface:forJob dsd:job.l3 ;
  surface:pairsSurface dsd:view.components ;
  surface:pairingRole surface:primary ;
  surface:arrival surface:cold_entry .

dsd:l3.chips a surface:Pairing ;
  rdfs:label "job.l3 to view.chips" ;
  rdfs:comment "A chip in prose opens a component without a trip through the catalogue." ;
  surface:forJob dsd:job.l3 ;
  surface:pairsSurface dsd:view.chips ;
  surface:pairingRole surface:secondary ;
  surface:arrival surface:no_move .

# ---- job.l4

dsd:l4.chips a surface:Pairing ;
  rdfs:label "job.l4 to view.chips" ;
  rdfs:comment "The chip on the term itself leads to its definition." ;
  surface:forJob dsd:job.l4 ;
  surface:pairsSurface dsd:view.chips ;
  surface:pairingRole surface:primary ;
  surface:arrival surface:no_move .

dsd:l4.palette a surface:Pairing ;
  rdfs:label "job.l4 to view.palette" ;
  rdfs:comment "The palette finds a term by name over the page the reader is on." ;
  surface:forJob dsd:job.l4 ;
  surface:pairsSurface dsd:view.palette ;
  surface:pairingRole surface:secondary ;
  surface:arrival surface:view_kept .

dsd:l4.definitions a surface:Pairing ;
  rdfs:label "job.l4 to view.definitions" ;
  rdfs:comment "The definitions graph shows the term among the terms it relates to." ;
  surface:forJob dsd:job.l4 ;
  surface:pairsSurface dsd:view.definitions ;
  surface:pairingRole surface:secondary ;
  surface:arrival surface:subject_kept .

