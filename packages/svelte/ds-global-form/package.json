{
  "name": "@canonical/svelte-ds-global-form",
  "description": "Svelte form fields for the Pragma design system, with bindable values.",
  "version": "0.47.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fixtures.*",
    "!dist/**/*.stories.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canonical/pragma-web.git"
  },
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/canonical/pragma-web/issues"
  },
  "homepage": "https://github.com/canonical/pragma-web/tree/main/packages/svelte/ds-global-form#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:all": "bun run build",
    "build": "svelte-package -o dist -i src/lib --tsconfig ./tsconfig.build.json",
    "build:storybook": "storybook build",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "svelte-check --tsconfig ./tsconfig.json",
    "check:webarchitect": "webarchitect package-svelte -v",
    "test": "vitest --run",
    "test:coverage": "COVERAGE=1 vitest --run --project=client --project=server --coverage",
    "test:ssr": "vitest --run --project=ssr",
    "test:client": "vitest --run --project=client",
    "storybook": "storybook dev -p 6006 --no-open --host 0.0.0.0",
    "test:server": "vitest --run --project=server"
  },
  "dependencies": {
    "@canonical/ds-utils": "^0.47.0",
    "@canonical/styles": "^0.47.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@canonical/biome-config": "0.46.0",
    "@canonical/storybook-addon-msw": "^0.47.0",
    "@canonical/storybook-config": "^0.47.0",
    "@canonical/storybook-helpers": "^0.47.0",
    "@canonical/svelte-ds-global": "^0.47.0",
    "@canonical/svelte-ssr-test": "^0.47.0",
    "@canonical/typescript-config-svelte": "^0.47.0",
    "@canonical/webarchitect": "0.46.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-svelte-csf": "^5.1.3",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tanstack/svelte-form": "1.33.5",
    "@types/bun": "^1.3.10",
    "@types/node": "^26.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "msw": "^3.0.0",
    "playwright": "^1.61.1",
    "storybook": "^10.6.0",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.0.1",
    "vitest": "^5.0.0",
    "vitest-browser-svelte": "^3.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.47.1"
  },
  "nx": {
    "tags": [
      "playwright"
    ]
  }
}
