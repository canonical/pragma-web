# Test screenshots
__screenshots__/
.vitest-attachments/

# [os] OS & editor files
Desktop.ini
Thumbs.db
._*
*.DS_Store
*~
\#*\#
.AppleDouble
.LSOverride
.spelling
.vscode
.idea
.kg/
session/
session*/
.gemini/
.agents/
pragma.code-workspace

# [cache] Cache and backup
*.bak
*.pyc
*-cache/
.yo-rc.json

# [data] Local data
*.sqlite*
*.log
logs/
pids
*.pid
*.seed
.*-metadata

# [deps] Local dependencies
.bundle/
node_modules/
vendor/
bower_components/
vendor/
# Normally lockfiles would be committed, but we use yarn instead of NPM for locking dependencies
package-lock.json
# [build] Built files
/build/
/parts/
/prime/
/stage/
*.egg-info
.snapcraft/
*.snap
# vitest snapshot baselines are source, not snapcraft artifacts
!**/__snapshots__/*.snap
_site/
*.*.map
dist/
# cross-process dist-build lock (the test gates' globalSetup): lives at each
# package root — OUTSIDE the ignored dist/ — and crash residue must never be
# committable (a committed lock blocks every clone's every run for the full
# 120s timeout before failing)
.dist-build.lock
storybook-static/
coverage/
.vite/
.vitest/

# [env] Local environment settings
.docker-project
.*.hash
.envrc
.env.local
env/
env[23]/

# [dotrun] Files generated by dotrun
.venv
.dotrun.json

# Project-specific ignores
js/app.js.map
static/js/modules

# NX cache
.nx/

.claude/
.kg/
node_modules

# relay-compiler artifacts of the source-shipped projections package: built by
# its `build` script at install, shipped in its tarball, never committed
packages/prism/projections/src/__generated__/

# relay-compiler artifacts of the source-shipped entity lens: its own, built
# by its `build` script at install and shipped in its tarball, and the
# projections fragments its spreads resolve against, compiled beside them and
# never shipped; neither is committed
packages/prism/lens-entity/src/__generated__/
packages/prism/lens-entity/.relay/
