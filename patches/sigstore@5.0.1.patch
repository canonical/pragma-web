+            // PATCHED (canonical/pragma): recover Rekor duplicate-entry 409s by
+            // fetching the existing entry instead of failing the signing flow.
+            // A create-entry POST that succeeds server-side but loses its
+            // response is retried by @sigstore/sign's fetchWithRetry; Rekor
+            // then answers 409 for the identical resubmission and, with
+            // fetchOnConflict disabled, the publish dies on its own success
+            // (v0.36.0: 53/55 packages published). @sigstore/sign 5.1.0 made
+            // fetchOnConflict default to true, but this explicit `false`
+            // still overrides that default. Drop this patch once the
+            // libnpmpublish that lerna depends on passes fetchOnConflict: true
+            // to sigstore (sigstore/sigstore-js#1791 adds the option,
+            // npm/cli#10341 passes it), or once a sigstore release stops
+            // passing `false` here.
+            fetchOnConflict: true,
             retry: options.retry ?? exports.DEFAULT_RETRY,
             timeout: options.timeout ?? exports.DEFAULT_TIMEOUT,
         }));
