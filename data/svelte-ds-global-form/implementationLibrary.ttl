@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ds: <https://ds.canonical.com/>.

ds:implementation.library.svelte-ds-global-form a ds:ImplementationLibrary;
    ds:libraryName "@canonical/svelte-ds-global-form";
    ds:platform "svelte";
    ds:link "https://github.com/canonical/pragma-web/tree/main/packages/svelte/ds-global-form";
    ds:summary "Svelte form fields for the Pragma design system, with bindable values.";
