{
  "root": "../../..",
  "sources": {
    "apps/react/pragma-docs/src": "pragma-docs",
    "packages/prism/projections/src": "pragma-docs"
  },
  "excludes": [
    "**/node_modules/**",
    "**/__generated__/**",
    "packages/prism/*/src/**/*.test.tsx",
    "packages/prism/*/src/**/*.stories.tsx",
    "**/dist/**"
  ],
  "projects": {
    "pragma-docs": {
      "schema": "apps/react/pragma-docs/src/relay/schema.graphql",
      "language": "typescript",
      "eagerEsModules": true,
      "output": "apps/react/pragma-docs/src/relay/__generated__",
      "schemaConfig": {
        "nodeInterfaceIdField": "uri",
        "nodeInterfaceIdVariableName": "id"
      }
    }
  }
}
