{
  "name": "@canonical/prism-metro",
  "private": true,
  "version": "0.44.1",
  "type": "module",
  "license": "GPL-3.0-only",
  "imports": {
    "#domains/lenses": "./src/domains/lenses/index.ts",
    "#i18n": "./src/i18n/index.ts",
    "#projections": "./src/projections/index.ts",
    "#relay": "./src/relay/index.ts",
    "#server": "./src/server/index.ts",
    "#shell": "./src/shell/index.ts",
    "#site": "./src/site/index.ts",
    "#sitemap": "./src/sitemap/index.ts"
  },
  "scripts": {
    "graph": "bun src/server/graph.ts",
    "schema": "bun src/server/schema.ts",
    "schema:check": "bun run schema && git diff --exit-code -- src/relay/schema.graphql",
    "relay": "relay-compiler",
    "dev": "vite",
    "dev:bun": "bun src/server/server.bun.ts",
    "preview": "bun run build:client && vite preview --outDir dist/client",
    "preview:bun": "bun run build:client && bun run build:server && bun src/server/preview.bun.ts",
    "build": "bun run build:client",
    "build:all": "bun run build:client && bun run build:server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --mode server",
    "check": "bun run check:biome && bun run check:ts && bun run schema:check && bun run relay",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@canonical/prism-core": "^0.44.1",
    "@canonical/prism-graph-example": "^0.44.1",
    "@canonical/prism-lens-definitions": "^0.44.1",
    "@canonical/prism-lens-entity": "^0.44.1",
    "@canonical/prism-projections": "^0.44.1",
    "@canonical/react-ds-global": "^0.44.1",
    "@canonical/react-head": "^0.44.1",
    "@canonical/react-hooks": "^0.44.1",
    "@canonical/react-ssr": "^0.44.1",
    "@canonical/router-core": "^0.44.1",
    "@canonical/router-react": "^0.44.1",
    "@canonical/styles": "^0.44.1",
    "graphql": "^16.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@canonical/biome-config": "0.43.0",
    "@canonical/typescript-config-react": "^0.44.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "browserslist": "^4.28.1",
    "bun-types": "^1.3.9",
    "jsdom": "^28.1.0",
    "lightningcss": "^1.32.0",
    "relay-compiler": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.0"
  }
}
