{
  "name": "@canonical/prism-metro",
  "private": true,
  "version": "0.44.1",
  "type": "module",
  "license": "GPL-3.0-only",
  "imports": {
    "#domains/fleet": "./src/domains/fleet/index.ts",
    "#domains/lenses": "./src/domains/lenses/index.ts",
    "#domains/metro": "./src/domains/metro/index.ts",
    "#i18n": "./src/i18n/index.ts",
    "#lib/site": "./src/lib/site/index.ts",
    "#lib/ui": "./src/lib/ui/index.ts",
    "#relay": "./src/relay/index.ts",
    "#relay/__generated__/*": "./src/relay/__generated__/*",
    "#server": "./src/server/index.ts",
    "#sitemap": "./src/sitemap/index.ts"
  },
  "scripts": {
    "graph": "bun run relay && bun src/server/graph.ts",
    "schema": "bun src/server/schema.ts",
    "schema:check": "bun run schema && git diff --exit-code -- src/relay/schema.graphql",
    "relay": "relay-compiler",
    "dev": "bun run relay && vite",
    "dev:bun": "bun run relay && bun src/server/server.bun.ts",
    "preview": "bun run build:client && vite preview --outDir dist/client",
    "preview:bun": "bun run build:client && bun run build:server && bun src/server/preview.bun.ts",
    "build": "bun run build:client",
    "build:all": "bun run build:client && bun run build:server && bun run build:storybook",
    "build:client": "bun run relay && vite build --ssrManifest --outDir dist/client",
    "build:server": "bun run relay && vite build --mode server",
    "build:storybook": "bun run relay && storybook build",
    "check": "bun run schema:check && bun run check:biome && bun run check:ts",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "bun run relay && tsc --noEmit",
    "test": "bun run relay && vitest run",
    "test:watch": "bun run relay && vitest",
    "test:coverage": "bun run relay && vitest run --coverage",
    "test:e2e": "bun run relay && vitest run --config vitest.e2e.config.ts",
    "storybook": "bun run relay && storybook dev -p 6011 --no-open --host 0.0.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/src/relay/__generated__"
        ]
      },
      "build:all": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/storybook-static",
          "{projectRoot}/src/relay/__generated__"
        ]
      }
    }
  },
  "dependencies": {
    "@canonical/i18n-core": "^0.44.1",
    "@canonical/prism-core": "^0.44.1",
    "@canonical/prism-graph-example": "^0.44.1",
    "@canonical/prism-lens-definitions": "^0.44.1",
    "@canonical/prism-lens-entity": "^0.44.1",
    "@canonical/prism-projections": "^0.44.1",
    "@canonical/react-ds-global": "^0.44.1",
    "@canonical/react-head": "^0.44.1",
    "@canonical/react-hooks": "^0.44.1",
    "@canonical/react-ssr": "^0.44.1",
    "@canonical/router-core": "^0.44.1",
    "@canonical/router-react": "^0.44.1",
    "@canonical/storybook-addon-relay": "^0.44.1",
    "@canonical/storybook-config": "^0.44.1",
    "@canonical/styles": "^0.44.1",
    "graphql": "^16.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@canonical/biome-config": "0.43.0",
    "@canonical/typescript-config-react": "^0.44.1",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@types/relay-test-utils": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "browserslist": "^4.28.1",
    "bun-types": "^1.3.9",
    "jsdom": "^28.1.0",
    "lightningcss": "^1.32.0",
    "playwright": "^1.61.1",
    "relay-compiler": "^21.0.1",
    "relay-test-utils": "^21.0.1",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.0"
  }
}
